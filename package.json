{
  "name": "technical-test-cfactory",
  "version": "1.0.0",
  "private": true,
  "description": "CFactory Async Image Processor (CAIP) — Image Processing Web Application with Async Worker Architecture",
  "workspaces": [
    "backend-api",
    "worker",
    "frontend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "dev:api": "npm --workspace=@caip/backend-api run dev",
    "dev:worker": "npm --workspace=@caip/worker run dev",
    "dev:frontend": "npm --workspace=@caip/frontend run dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
