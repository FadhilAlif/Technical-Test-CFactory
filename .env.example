# ==============================================================================
# CFactory Async Image Processor (CAIP) — Environment Variables Template
# Copy this file to .env and fill in your NeonDB PostgreSQL connection string.
# ==============================================================================

# 1. Primary Database — NeonDB PostgreSQL (SSL required for NeonDB)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Message Queue Broker — Redis 7 (BullMQ)
# For local development: redis://localhost:6379
# Inside Docker Compose: redis://redis:6379
REDIS_URL=redis://localhost:6379
BULLMQ_QUEUE_NAME=image-processing-queue

# 3. Shared Storage Configuration
# Relative or absolute path where raw uploads and processed .webp files are stored
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=20971520

# 4. Backend API Server (Hono — Port 4000)
PORT=4000
CORS_ORIGIN=http://localhost:3000

# 5. Background Worker (BullMQ + Sharp)
WORKER_CONCURRENCY=2

# 6. Interactive Frontend (Next.js App Router — Port 3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MAX_FILE_SIZE_MB=20
